{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papercheck.local/schema/proposal.schema.json",
  "title": "papercheck proposal (descriptive contract)",
  "description": "Agent proposals. Descriptive extensions are retained in the run; identity, byte ranges and semantic references are validated.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "paper_sha256",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "base_state_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "paper_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "note": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_ranges"
        ],
        "properties": {
          "container_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "variant_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "block_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "block_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source_ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "start_byte",
                "end_byte"
              ],
              "properties": {
                "start_byte": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "lineage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "required": [
              "type",
              "from"
            ],
            "properties": {
              "type": {
                "enum": [
                  "split",
                  "merge"
                ]
              },
              "group": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "from": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "untracked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "start_byte",
          "end_byte"
        ],
        "properties": {
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "surface_statement": {
                "type": "string",
                "minLength": 1
              },
              "canonical_statement": {
                "type": "object"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "review_requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "ref",
              "surface_statement",
              "canonical_statement"
            ]
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "segment": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "claim",
              "segment",
              "reason"
            ]
          }
        },
        "non_claim_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "segment": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "segment",
              "reason"
            ]
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "operation": {
                "enum": [
                  "REPLACEMENT",
                  "SPLIT",
                  "MERGE",
                  "RESTORE",
                  "DELETE"
                ]
              },
              "before": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "placements": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "claim",
                    "placements"
                  ]
                }
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "claim": {
                      "type": "string",
                      "minLength": 1
                    },
                    "segments": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "claim",
                    "segments"
                  ]
                }
              },
              "status": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "operation",
              "before",
              "after",
              "status",
              "reason"
            ]
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "source_access": {
                "enum": [
                  "full_text",
                  "abstract_only",
                  "snippet_only",
                  "metadata_only",
                  "unavailable"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "file_sha256": {
                "type": "string",
                "minLength": 1
              },
              "dataset_id": {
                "type": "string",
                "minLength": 1
              },
              "study_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "title",
              "source_access"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "object",
                "minProperties": 1
              },
              "shared_source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dataset_id": {
                "type": "string",
                "minLength": 1
              },
              "study_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "reference",
              "quote",
              "locator"
            ]
          }
        },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "enum": [
                      "point",
                      "range",
                      "interval"
                    ]
                  },
                  "value_decimal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value_lower": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value_upper": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "type"
                ]
              },
              "operator": {
                "enum": [
                  "=",
                  "<",
                  ">",
                  "<=",
                  ">="
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "segment": {
                "type": "string",
                "minLength": 1
              },
              "source_expression": {
                "type": "string",
                "minLength": 1
              },
              "extraction_status": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "pending"
                ]
              },
              "tolerance_decimal": {
                "type": "string",
                "minLength": 1
              },
              "precision": {
                "enum": [
                  "exact",
                  "as_written"
                ]
              },
              "derivation": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": true,
                "properties": {
                  "op": {
                    "enum": [
                      "sum",
                      "difference",
                      "product",
                      "ratio",
                      "mean",
                      "weighted_mean",
                      "share"
                    ]
                  },
                  "inputs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "weights": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "scale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "op",
                  "inputs"
                ]
              }
            },
            "required": [
              "ref",
              "metric_id",
              "value",
              "unit",
              "segment",
              "source_expression",
              "extraction_status"
            ]
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "dst": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "DEPENDS_ON",
                  "SUPPORTS",
                  "ENTAILS",
                  "CONTRADICTS",
                  "QUALIFIES"
                ]
              },
              "status": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "src",
              "dst",
              "type",
              "status",
              "reason"
            ]
          }
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "supported",
                  "partially_supported",
                  "unsupported",
                  "counterevidence",
                  "unknown",
                  "pending"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "claim",
              "evidence",
              "status",
              "reason"
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "pass",
                  "fail",
                  "conflict",
                  "insufficient_evidence",
                  "incomparable",
                  "pending",
                  "error"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "claim_ids",
              "kind",
              "outcome",
              "reason",
              "method"
            ]
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "conclusion": {
                "type": "string",
                "minLength": 1
              },
              "premises": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "status": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "conclusion",
              "premises",
              "status",
              "reason"
            ]
          }
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "revision_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "rejected"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "revision_id",
              "status",
              "reason"
            ]
          }
        },
        "invalidate_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check_id",
              "reason"
            ]
          }
        }
      },
      "required": [
        "bindings"
      ]
    }
  }
}
